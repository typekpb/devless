# AWS Configuration
AWS_REGION=eu-central-1

# GitHub App Configuration
GITHUB_APP_ID=123456
GITHUB_APP_INSTALLATION_ID=789012
GITHUB_APP_PRIVATE_KEY_FILE=~/.devless/github-app.pem
# Or inline: GITHUB_APP_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----...

# SQS Queue
SQS_QUEUE_URL=https://sqs.eu-central-1.amazonaws.com/123456789/devless-agent-tasks

# Optional: Override default model (default: claude-3-haiku)
# BEDROCK_MODEL=anthropic.claude-3-haiku-20240307-v1:0
