# Copy this file to terraform.tfvars and fill in your values.
# terraform.tfvars is gitignored — it won't be committed.
#
# For the private key, save your PEM file as github-app-private-key.pem
# in this directory (also gitignored) and pass it via environment variable:
#
#   export TF_VAR_github_app_private_key="$(cat github-app-private-key.pem)"
#   terraform apply
#

github_app_id              = "123456"
github_app_installation_id = "12345678"
openai_api_key             = "sk-..."
webhook_secret             = "your-random-webhook-secret"
github_actions_org         = "your-github-org"
